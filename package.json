{
  "name": "flight-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "local": "vite --host 127.0.0.1 --port 5173 --strictPort --mode local-dev",
    "local:api": "node scripts/local/server.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "ingest": "node --env-file-if-exists=.env.local scripts/ingest.mjs",
    "source-check": "node --env-file-if-exists=.env.local scripts/source-check.mjs",
    "supabase": "supabase"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "fast-xml-parser": "5.11.2",
    "lucide-react": "1.53.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "18.3.24",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.3"
  }
}
