# These two values are public. Never put a secret in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GITHUB_URL=

# Local ingestion only. Configure these as Edge Function secrets in production.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
INGEST_CRON_SECRET=
INGEST_BATCH_SIZE=12
# Leave blank until the one-week trial establishes actual costs.
DEEPSEEK_MONTHLY_LIMIT_USD=
DEEPSEEK_INPUT_USD_PER_MILLION=0.30
DEEPSEEK_OUTPUT_USD_PER_MILLION=1.20
GITHUB_TOKEN=
